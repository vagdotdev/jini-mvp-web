# App URL (no trailing slash) — used to build viewer/host/buddy links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (create project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to browser. Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED for admin APIs (create/list/end streams, wallet top-up, orders, users).
# Send header: x-jini-create-secret: <same value>
# Missing secret → APIs return 503 (fail closed).
JINI_STREAM_CREATE_SECRET=change-me-local-admin-secret

# REQUIRED for POST/GET /api/items/release-expired-locks
# Authorization: Bearer <same value>
# Hit it on a 1-minute schedule (e.g. Vercel Cron, GitHub Actions, simple curl).
JINI_CRON_SECRET=change-me-local-cron-secret

# LiveKit Cloud — host camera + viewer playback (https://cloud.livekit.io → project → Settings → Keys)
# LIVEKIT_URL is the WebSocket URL, e.g. wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Razorpay (https://dashboard.razorpay.com → API Keys + Webhooks)
# Used by /api/payments/razorpay/* — omit until company KYC is done.
# Architecture + security notes: lib/payments/README.md
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED before enabling webhooks — unsigned webhooks are rejected.
# Dashboard → Webhooks → signing secret for POST /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Pilot-only: allow /api/dev/login-as-ganesh in production builds.
# Leave unset/false in real prod. Local `next dev` allows pilot login by default.
# JINI_ALLOW_PILOT_LOGIN=false

# Optional Phase 2b — Google AI / Vertex for product image styling
GOOGLE_AI_API_KEY=
